    "safety.general": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a single layer and check early. Follow your fryer’s preheat instructions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单层摆放，首次提前检查。按说明书处理预热。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單層擺放，第一次提早檢查。依說明書預熱。"
          }
        }
      }
    },
    "safety.package": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow the package’s air fryer directions when available. Check early."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包装有空气炸锅说明时优先照做，并提前检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包裝有氣炸鍋說明時優先依照包裝，並提早檢查。"
          }
        }
      }
    },
    "safety.precooked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For products labeled fully cooked. Follow the package’s air fryer directions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于标明全熟的产品。请优先按包装的空气炸锅说明操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於標示全熟的產品。請優先依照包裝的氣炸鍋說明。"
          }
        }
      }
    },
    "safety.poultry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a thermometer to check the center reaches at least 165°F (74°C)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用温度计确认中心至少达 74°C（165°F）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用溫度計確認中心至少達 74°C（165°F）。"
          }
        }
      }
    },
    "safety.salmon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start skin side down. Check the center reaches 145°F (63°C)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鱼皮朝下，用温度计确认中心达到 63°C（145°F）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "魚皮朝下，用溫度計確認中心達到 63°C（145°F）。"
          }
        }
      }
    },
    "safety.shrimp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook until the shrimp are pearly or white and opaque."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "烤至虾肉呈珠白或白色，且不透明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "烤至蝦肉呈珠白或白色，且不透明。"
          }
        }
      }
    },
    "safety.leftovers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reheat leftovers to 165°F (74°C) in the center."
